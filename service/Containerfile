FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
WORKDIR /app
RUN sed -i '/^Components:/ { /universe/! s/$/ universe/; }' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-numpy python3-pandas python3-sklearn python3-scipy \
      python3-joblib python3-fastapi python3-uvicorn python3-httpx \
      python3-pytest python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app
COPY . /app
RUN chown -R app:app /app
USER 10001
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
