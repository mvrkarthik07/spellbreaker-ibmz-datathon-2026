FROM python:3.11-slim
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY ml/requirements.txt /tmp/ml-requirements.txt
COPY service/requirements.txt /tmp/service-requirements.txt
RUN pip install --no-cache-dir -r /tmp/ml-requirements.txt -r /tmp/service-requirements.txt && useradd --create-home --uid 10001 app
COPY . /app
RUN chown -R app:app /app
USER 10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
